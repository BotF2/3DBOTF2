    m_Metadata:
      m_Items: []
  - m_Id: 23061993251872780
    m_Localized: "Dyplomacja zmieni\u0142a si\u0119 wraz z {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 23061993251872781
    m_Localized: "Stan wojny istnieje mi\u0119dzy {0} a {1}. Wszystkie traktaty pokojowe
