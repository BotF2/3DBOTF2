    m_Metadata:
      m_Items: []
  - m_Id: 23061993251872782
    m_Localized: "Relacje mi\u0119dzy {0} i {1} ustabilizowa\u0142y si\u0119 na neutralnym
      poziomie."
    m_Metadata:
      m_Items: []
  - m_Id: 23061993251872783
    m_Localized: "Osi\u0105gni\u0119to porozumienie pokojowe pomi\u0119dzy {0} i
      {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 23061993251872784
    m_Localized: "{0} i {1} zawar\u0142y sojusz. Wzajemna obrona jest teraz aktywna."
