    m_Localized: Guerra dichiarata con {0}
    m_Metadata:
      m_Items: []
  - m_Id: 23061993251872777
    m_Localized: 'Relazioni con {0}: neutro'
    m_Metadata:
      m_Items: []
  - m_Id: 23061993251872778
    m_Localized: Accordo di pace con {0}
    m_Metadata:
      m_Items: []
  - m_Id: 23061993251872779
    m_Localized: Alleanza forgiata con {0}
    m_Metadata:
      m_Items: []
  - m_Id: 23061993251872780
    m_Localized: "La diplomazia \xE8 cambiata con {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 23061993251872781
    m_Localized: "Tra {0} e {1} \xE8 in vigore uno stato di guerra. Tutti i trattati
      di pace sono nulli."
    m_Metadata:
      m_Items: []
  - m_Id: 23061993251872782
    m_Localized: Le relazioni tra {0} e {1} si sono stabilizzate su un livello neutro.
    m_Metadata:
      m_Items: []
  - m_Id: 23061993251872783
    m_Localized: "\xC8 stato raggiunto un accordo di pace tra {0} e {1}."
    m_Metadata:
      m_Items: []
  - m_Id: 23061993251872784
    m_Localized: "\xC8 stata stretta un'alleanza tra {0} e {1}. La difesa reciproca
      \xE8 ora attiva."
    m_Metadata:
      m_Items: []
  - m_Id: 23061993251872785
    m_Localized: "La resistenza \xE8 inutile"
    m_Metadata:
      m_Items: []
  - m_Id: 23061993251872786
    m_Localized: '{0} navi'
    m_Metadata:
      m_Items: []
