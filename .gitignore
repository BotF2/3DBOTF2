# Claude settings with potential secrets
.claude/settingsOld*.json
.claude/settingsOLD.json
.claude/settings.local.json
/Assets/LevelData/SuperCoolFogLevel.json.meta

# UserSettings holds per-machine Editor state (layouts, package caches, etc.) - never share via git
/UserSettings/
/Assets/_Recovery/1 (5).unity
/Assets/_Recovery/1 (5).unity.meta
